# ============================================================
# REQUIRED — NextAuth Core
# ============================================================

# A random secret string used to encrypt session tokens.
# Generate one by running: openssl rand -base64 32
NEXTAUTH_SECRET=

# Your site's full URL (include https://).
# On Vercel this is auto-detected from VERCEL_URL if not set,
# but it's best to set it explicitly to your custom domain.
NEXTAUTH_URL=https://spacebaddie.com

# ============================================================
# OPTIONAL — OAuth Providers (add whichever ones you need)
# ============================================================

# YouTube / Google OAuth 2.0
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth 2.0 Client ID (Web application)
# 3. Add redirect URI: https://spacebaddie.com/api/auth/callback/google
# 4. Enable "YouTube Data API v3" under APIs & Services → Library
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Twitter / X OAuth 2.0
# 1. Go to https://developer.twitter.com/en/portal/projects-and-apps
# 2. Create or select an app, enable OAuth 2.0
# 3. Set type to "Web App"
# 4. Add redirect URI: https://spacebaddie.com/api/auth/callback/twitter
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Instagram Basic Display API
# 1. Go to https://developers.facebook.com/apps/
# 2. Create an app, add "Instagram Basic Display"
# 3. Add redirect URI: https://spacebaddie.com/api/auth/callback/instagram
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# TikTok Login Kit
# 1. Go to https://developers.tiktok.com/
# 2. Create an app, add "Login Kit"
# 3. Add redirect URI: https://spacebaddie.com/api/auth/callback/tiktok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
